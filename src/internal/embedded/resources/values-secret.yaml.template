# ---------------------------------------------------------------------------
# Airgap / disconnected GitOps trust (patternizer airgap bootstrap ONLY).
# Not loaded into Vault by make load-secrets. Copy this file to
# ~/values-secret-<pattern>.yaml (or keep paths local) and fill in real paths.
#
# UX:
#   Copy this template to ~/values-secret-<pattern>.yaml and fill in airgap: paths.
#   ./pattern.sh make install-airgap
#
# Or manually:
#   patternizer airgap bootstrap /path/to/pattern --output-dir ./airgap-bootstrap
#   ./airgap-bootstrap/apply-airgap.sh pre    # before install
#   ./pattern.sh make install
#   ./airgap-bootstrap/apply-airgap.sh post   # after vp-gitops exists
#
# clusterProxy: CA for patterns-operator git clone (Proxy/user-ca-bundle)
# argocdTLS:    CA for Argo CD (argocd-tls-certs-cm + trusted-ca-bundle)
# registries:   OCI/Helm mirror credentials for Argo CD repo-creds
# ---------------------------------------------------------------------------
# airgap:
#   argocdNamespace: vp-gitops
#   patternsOperatorNamespace: patterns-operator
#   certificates:
#     - name: gitea
#       fields:
#       - name: host
#         value: gitea.airgap.rhuk.lab
#       - name: ca
#         path: /home/fedora/gitea_container_certs/cert.pem
#       - name: clusterProxy
#         value: "true"
#       - name: argocdTLS
#         value: "true"
#     - name: mirror-registry
#       fields:
#       - name: host
#         value: mirror.airgap.rhuk.lab
#       - name: ca
#         path: /etc/pki/ca-trust/source/anchors/quay-rootCA.pem
#       - name: clusterProxy
#         value: "true"
#       - name: argocdTLS
#         value: "true"
#   registries:
#     - name: mirror
#       fields:
#       - name: url
#         value: mirror.airgap.rhuk.lab:8443
#       - name: dockerconfig
#         path: ~/.docker/config.json
#       # Or username + password file instead of dockerconfig:
#       # - name: username
#       #   value: init
#       # - name: password
#       #   path: /path/to/registry.password
#
#   # Disconnected pattern values (rendered into values-global.yaml + variants)
#   registry: mirror.airgap.rhuk.lab:8443
